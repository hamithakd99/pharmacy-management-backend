// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User { 
  id    Int     @id @default(autoincrement())
  createdAt DateTime @default(now())
  userId String @unique
  firstName  String
  lastName  String
  email String  @unique
  password String
  role Role @default(EMPLOYEE)
  contactNumber String
  nickName String?
  
  addressLine1  String
  addressLine2  String?
  city String
  province Province
  postalCode String?
  orders Order[]
}

model ExternalUser {
  id    Int     @id @default(autoincrement())
  userId String @unique
  firstName  String
  lastName  String
  email String  @unique
  role ExternalUserRole @default(CUSTOMER)
  contactNumber String
  nickName String?
  
  addressLine1  String
  addressLine2  String?
  city String
  province Province
  postalCode String?
  suppliedBatches StockBatch[]
  purchaseOrders PurchaseOrder[]
  orders Order[]

}

model Product {
  id    Int     @id @default(autoincrement())
  
  productId String @unique
  name String


  brand String?
  description String?

  strengthValue Float? //remove optional "?" for development, add it back for production
  strengthUnit StrengthUnit?
  dosageForm DosageForm?

  packSize Int?

  categoryId Int?
  //remove optional "?" for development, add it back for production
  category Category? @relation(fields: [categoryId], references: [id])
  stockBatchItems StockBatchItem[]
  purchaseOrderItems PurchaseOrderItem[]

  reorderLevel Int @default(10)
  isActive Boolean @default(true)

  orderItems OrderItem[]
  stockMovements StockMovement[]

}

model StockBatch {
  id Int @id @default(autoincrement())

  batchNumber String @unique
  invoiceNumber String @unique
  
  supplierId Int
  supplier ExternalUser @relation(fields: [supplierId], references: [id])

  receivedDate DateTime @default(now())

  invoiceDiscountAmount Float @default(0)

  paymentStatus PaymentStatus @default(PENDING)

  items StockBatchItem[]

  purchaseOrderId Int? 
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references:[id])
  
}

model StockBatchItem {
  id Int @id @default(autoincrement())

  stockBatchId Int
  stockBatch StockBatch @relation(fields: [stockBatchId], references: [id])

  productId Int
  product Product @relation(fields: [productId], references: [id])

  receivedQuantity Int
  availableQuantity Int

  orderItems OrderItem[]
  stockMovements StockMovement[]

  purchaseOrderItemId Int?
  purchaseOrderItem PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])

  buyingPrice Float
  sellingPrice Float

  expiryDate DateTime
  manufacturingDate DateTime?
}

model Category {
  id Int @id @default(autoincrement())
  name String @unique
  products Product[]
}

model PurchaseOrder {
  id Int @id @default(autoincrement())
  orderNumber String @unique
  supplierId Int
  supplier ExternalUser @relation(fields: [supplierId], references: [id])
  createdAt DateTime @default(now())
  status PurchaseOrderStatus @default(PENDING)
  items PurchaseOrderItem[]
  stockBatch StockBatch[]
}

model PurchaseOrderItem {
  id Int @id @default(autoincrement())
  purchaseOrderId Int
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productId Int
  product Product @relation(fields: [productId], references: [id])
  quantity Int

  stockBatchItems StockBatchItem[]
}

model Order {
    id Int @id @default(autoincrement())
    orderNumber String @unique
    createdAt DateTime @default(now())

    customerId Int?
    customer ExternalUser? @relation(fields: [customerId], references: [id])

    cashierId String
    cashier User @relation(fields: [cashierId], references: [userId])

    status OrderStatus @default(COMPLETED)
    paymentStatus OrderPaymentStatus @default(PENDING)
    paymentMethod PaymentMethod?

    subtotal Float @default(0)
    discountAmount Float @default(0)
    totalAmount Float @default(0)

    items OrderItem[]
    stockMovements StockMovement[]
}


model OrderItem {
    id Int @id @default(autoincrement())

    orderId Int
    order Order @relation(fields: [orderId], references: [id])

    productId Int
    product Product @relation(fields: [productId], references: [id])

    stockBatchItemId Int
    stockBatchItem StockBatchItem @relation(fields: [stockBatchItemId], references: [id])

    quantity Int
    sellingPrice Float
    lineTotal Float

    stockMovements StockMovement[]
}

model StockMovement {
    id Int @id @default(autoincrement())
    createdAt DateTime @default(now())

    stockBatchItemId Int
    stockBatchItem StockBatchItem @relation( fields: [stockBatchItemId], references: [id] )

    productId Int
    product Product @relation( fields: [productId], references: [id] )

    type StockMovementType

    quantity Int

    orderId Int?
    order Order? @relation( fields: [orderId], references: [id] )

    orderItemId Int?
    orderItem OrderItem? @relation( fields: [orderItemId], references: [id] )

    note String?
}

enum StockMovementType {
    GRN
    SALE
    RETURN
    ADJUSTMENT
}

enum OrderStatus {
    DRAFT
    COMPLETED
    CANCELLED
}

enum OrderPaymentStatus {
    PENDING
    PAID
    PARTIAL
    REFUNDED
}

enum PaymentMethod {
    CASH
    CARD
    BANK_TRANSFER
    OTHER
}

enum Role {
  EMPLOYEE
  ADMIN
  CASHIER
  
}

enum Province {
  WESTERN
  CENTRAL
  SOUTHERN
  NORTHERN
  EASTERN
  NORTH_WESTERN
  NORTH_CENTRAL
  UVA
  SABARAGAMUWA
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  PARTIAL
}

enum ExternalUserRole {
  CUSTOMER
  SUPPLIER
}

enum StrengthUnit {
  MG
  ML
  G
}

enum DosageForm {
  TABLET
  CAPSULE
  SYRUP
  INJECTION
  CREAM
  OINTMENT
  DROPS
}

enum PurchaseOrderStatus {
  PENDING
  APPROVED
  PARTIALLY_RECEIVED
  COMPLETED
  CANCELLED
}